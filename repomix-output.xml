  );

CREATE POLICY "clients_company_insert" ON clients
  FOR INSERT WITH CHECK (
    can_write_company(company_id)
  );

CREATE POLICY "clients_company_update" ON clients
  FOR UPDATE USING (
    can_write_company(company_id)
  );

CREATE POLICY "clients_company_delete" ON clients
  FOR DELETE USING (
