# ARCA - WSAA/WSFEv1 (homologación)
# Copiá este archivo a .env y completá con tus datos.
# Los certificados viven en ./certificados/ (gitignoreado, nunca comitear)
AFIP_ENVIRONMENT=testing
AFIP_CUIT=
AFIP_CERT_PATH=./certificados/certificado.crt
AFIP_KEY_PATH=./certificados/invotrack.key

# Supabase (necesario para la app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
